  <style>
    body {
      background-color: #fcf4ed;
      color: #0a1a3e;
      margin: 0;
      font-family: 'Inter', sans-serif;
    }

    .thank-you-page {
      text-align: center;
      padding: 40px 20px;
      max-width: 760px;
      margin: 0 auto;
    }

    .header-tag {
      display: inline-block;
      color: #0a1a3e;
      font-weight: 700;
      font-size: 1.1rem;
      margin-bottom: 1.5rem;
      border: 2px solid #0a1a3e !important;
      padding: 15px 25px;
      background: #fcf4ed;
      letter-spacing: 1px;
    }

    .card-box {
      border: 2px solid #0a1a3e !important;
      padding: 35px 25px;
      background: #ffffff;
      border-radius: 6px;
      margin-bottom: 2rem;
    }

    .heading {
      color: #0a1a3e;
      margin: 0 0 1rem 0;
      font-size: 2.2rem;
      font-weight: 900;
      letter-spacing: 1px;
    }

    .message-cy {
      font-size: 1.15rem;
      font-weight: 700;
      line-height: 1.6;
      margin-bottom: 1.5rem;
      color: #0a1a3e;
    }

    .divider {
      border: 0;
      height: 2px;
      background: #0a1a3e;
      width: 60px;
      margin: 1.5rem auto;
    }

    .message-en {
      font-size: 1.05rem;
      font-weight: 400;
      line-height: 1.6;
      color: #4a5568;
    }

    .btn-large {
      display: inline-block;
      background-color: #0a1a3e;
      color: #ffffff !important;
      padding: 16px 28px;
      font-weight: 700;
      text-decoration: none;
      border-radius: 4px;
      border: 2px solid #0a1a3e !important;
      transition: background-color 0.2s ease, color 0.2s ease;
      line-height: 1.4;
    }

    .btn-large:hover {
      background-color: #ffffff;
      color: #0a1a3e !important;
    }

    .site-footer {
      font-size: 12px;
      text-align: center;
      padding: 20px;
      color: #ffffff;
      background: #0a1a3e;
      letter-spacing: 0.5px;
      line-height: 1.5;
      margin-top: 40px;
    }

    .site-footer a {
      color: #ffffff;
      text-decoration: underline;
    }
