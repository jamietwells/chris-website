<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welsh Communities Map</title>

    <!-- Tailwind CSS for UI Layout -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <!-- External GeoJSON Data File -->
    <script src="welsh_communities.js"></script>

    <style>
        #map {
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        .leaflet-popup-content-wrapper {
            border-radius: 0.75rem;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            padding: 0.25rem;
        }

        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        ::-webkit-scrollbar-thumb {
            background: #f472b6;
            border-radius: 3px;
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 font-sans h-screen w-screen overflow-hidden flex flex-col">

    <!-- Header Navigation -->
    <header class="bg-slate-900/90 backdrop-blur border-b border-slate-800 px-4 py-3 flex items-center justify-between z-10 shadow-md">
        <div class="flex items-center space-x-3">
            <div class="bg-pink-500/20 p-2 rounded-lg border border-pink-500/30">
                <svg class="w-6 h-6 text-pink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
                </svg>
            </div>
            <div>
                <h1 class="font-bold text-lg text-white leading-tight">Welsh Communities Map</h1>
                <p class="text-xs text-slate-400">Interactive GeoJSON Community Boundaries</p>
            </div>
        </div>

        <div class="flex items-center space-x-2">
            <button id="toggle-sidebar" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-pink-400 hover:text-pink-300 text-xs font-semibold rounded-lg border border-slate-700 transition flex items-center gap-1.5 shadow-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                <span>Edit / View GeoJSON</span>
            </button>
            <button id="reset-view-btn" class="px-3 py-1.5 bg-pink-600 hover:bg-pink-500 text-white text-xs font-semibold rounded-lg shadow-sm transition">
                Reset View
            </button>
        </div>
    </header>

    <!-- Main Content Area -->
    <div class="relative flex-1 w-full h-full overflow-hidden">
        
        <!-- Map Canvas -->
        <div id="map"></div>

        <!-- Floating Data Control Panel / Drawer -->
        <div id="geojson-panel" class="absolute top-4 right-4 z-20 w-96 max-w-[calc(100vw-2rem)] bg-slate-900/95 backdrop-blur-md rounded-xl border border-slate-800 shadow-2xl transition-all duration-300 transform translate-x-0 flex flex-col max-h-[calc(100vh-6rem)]">
            <div class="p-4 border-b border-slate-800 flex justify-between items-center">
                <h2 class="text-sm font-semibold text-pink-400 uppercase tracking-wider flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                    GeoJSON Data Input
                </h2>
                <button id="close-panel" class="text-slate-400 hover:text-white p-1 rounded-md transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
            
            <div class="p-4 flex-1 flex flex-col gap-3 overflow-y-auto">
                <p class="text-xs text-slate-400">
                    Loaded from <code class="text-pink-400">welsh_communities.js</code>. Edit or paste custom GeoJSON data below to render on demand.
                </p>

                <textarea id="geojson-input" class="w-full h-48 bg-slate-950 border border-slate-800 rounded-lg p-3 text-xs font-mono text-pink-300 focus:outline-none focus:border-pink-500 transition resize-none" placeholder="Paste GeoJSON feature collection here..."></textarea>

                <div id="status-msg" class="text-xs p-2 rounded hidden"></div>

                <div class="flex gap-2 pt-2">
                    <button id="apply-geojson" class="flex-1 bg-pink-600 hover:bg-pink-500 text-white py-2 px-3 rounded-lg text-xs font-semibold shadow transition flex items-center justify-center gap-1.5">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Update Map
                    </button>
                    <button id="load-sample" class="bg-slate-800 hover:bg-slate-700 text-slate-300 py-2 px-3 rounded-lg text-xs font-medium border border-slate-700 transition">
                        Reload From File
                    </button>
                </div>
            </div>

            <!-- Style Controls -->
            <div class="p-4 border-t border-slate-800 bg-slate-950/50 rounded-b-xl flex flex-col gap-3">
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Style Settings</div>
                <div class="grid grid-cols-2 gap-3 text-xs">
                    <div>
                        <label class="text-slate-400 block mb-1">Stroke Color</label>
                        <div class="flex items-center gap-2">
                            <input type="color" id="stroke-color" value="#ec4899" class="bg-transparent cursor-pointer rounded h-7 w-7 border-0">
                            <span id="stroke-color-val" class="text-slate-300 font-mono text-[11px]">#ec4899</span>
                        </div>
                    </div>
                    <div>
                        <label class="text-slate-400 block mb-1">Stroke Weight</label>
                        <input type="range" id="stroke-weight" min="1" max="8" value="3" class="w-full accent-pink-500">
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Application Logic -->
    <script>
        let map, geoJsonLayer;

        window.onload = function() {
            initMap();
            setupEventListeners();
        };

        function initMap() {
            map = L.map('map', {
                zoomControl: true,
                attributionControl: true
            }).setView([52.875, -4.450], 11);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);

            // Populates input box with GeoJSON from welsh_communities.js
            const activeData = (typeof welshCommunitiesGeoJSON !== 'undefined') ? welshCommunitiesGeoJSON : { type: "FeatureCollection", features: [] };
            document.getElementById('geojson-input').value = JSON.stringify(activeData, null, 2);
            
            renderGeoJSON(activeData);
        }

        function getStyleOptions() {
            return {
                color: document.getElementById('stroke-color').value,
                weight: parseInt(document.getElementById('stroke-weight').value, 10),
                opacity: 0.9,
                fillColor: '#000000',
                fillOpacity: 0.0
            };
        }

        function renderGeoJSON(geojsonData) {
            if (geoJsonLayer) {
                map.removeLayer(geoJsonLayer);
            }

            try {
                const styleOptions = getStyleOptions();

                geoJsonLayer = L.geoJSON(geojsonData, {
                    style: function() {
                        return styleOptions;
                    },
                    onEachFeature: function(feature, layer) {
                        layer.on({
                            mouseover: function(e) {
                                const l = e.target;
                                l.setStyle({
                                    weight: styleOptions.weight + 2,
                                    opacity: 1,
                                    fillOpacity: 0.15,
                                    fillColor: styleOptions.color
                                });
                            },
                            mouseout: function(e) {
                                geoJsonLayer.resetStyle(e.target);
                            }
                        });

                        if (feature.properties) {
                            let popupContent = '<div class="text-slate-900 p-2 font-sans">';
                            popupContent += `<h3 class="font-bold text-sm text-pink-600 border-b pb-1 mb-1">${feature.properties.name || 'Community Boundary'}</h3>`;

                            for (const key in feature.properties) {
                                if (key !== 'name') {
                                    popupContent += `<div class="text-xs text-slate-600"><span class="font-semibold text-slate-800 uppercase text-[10px]">${key}:</span> ${feature.properties[key]}</div>`;
                                }
                            }
                            popupContent += '</div>';
                            layer.bindPopup(popupContent);
                        }
                    }
                }).addTo(map);

                if (geoJsonLayer.getBounds().isValid()) {
                    map.fitBounds(geoJsonLayer.getBounds(), { padding: [40, 40] });
                }

                showStatus("Map rendered successfully!", "success");
            } catch (err) {
                showStatus("Error rendering GeoJSON: " + err.message, "error");
            }
        }

        function setupEventListeners() {
            const panel = document.getElementById('geojson-panel');
            
            document.getElementById('toggle-sidebar').addEventListener('click', () => {
                panel.classList.toggle('translate-x-0');
                panel.classList.toggle('translate-x-full');
            });

            document.getElementById('close-panel').addEventListener('click', () => {
                panel.classList.add('translate-x-full');
                panel.classList.remove('translate-x-0');
            });

            document.getElementById('apply-geojson').addEventListener('click', () => {
                const rawData = document.getElementById('geojson-input').value;
                try {
                    const parsed = JSON.parse(rawData);
                    renderGeoJSON(parsed);
                } catch (e) {
                    showStatus("Invalid JSON syntax.", "error");
                }
            });

            document.getElementById('load-sample').addEventListener('click', () => {
                const activeData = (typeof welshCommunitiesGeoJSON !== 'undefined') ? welshCommunitiesGeoJSON : { type: "FeatureCollection", features: [] };
                document.getElementById('geojson-input').value = JSON.stringify(activeData, null, 2);
                renderGeoJSON(activeData);
            });

            document.getElementById('reset-view-btn').addEventListener('click', () => {
                if (geoJsonLayer && geoJsonLayer.getBounds().isValid()) {
                    map.fitBounds(geoJsonLayer.getBounds(), { padding: [40, 40] });
                } else {
                    map.setView([52.875, -4.450], 11);
                }
            });

            const strokeColorInput = document.getElementById('stroke-color');
            const strokeColorVal = document.getElementById('stroke-color-val');
            const strokeWeightInput = document.getElementById('stroke-weight');

            strokeColorInput.addEventListener('input', (e) => {
                strokeColorVal.textContent = e.target.value;
                updateStyle();
            });

            strokeWeightInput.addEventListener('input', updateStyle);
        }

        function updateStyle() {
            if (geoJsonLayer) {
                geoJsonLayer.setStyle(getStyleOptions());
            }
        }

        function showStatus(message, type) {
            const statusEl = document.getElementById('status-msg');
            statusEl.textContent = message;
            statusEl.classList.remove('hidden', 'bg-red-900/50', 'text-red-300', 'bg-emerald-900/50', 'text-emerald-300');

            if (type === 'error') {
                statusEl.classList.add('bg-red-900/50', 'text-red-300', 'border', 'border-red-700/50');
            } else {
                statusEl.classList.add('bg-emerald-900/50', 'text-emerald-300', 'border', 'border-emerald-700/50');
            }

            setTimeout(() => statusEl.classList.add('hidden'), 4000);
        }
    </script>
</body>
</html>
