{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tendring-dp",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/pwllheli",
      "/pwllheli/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
